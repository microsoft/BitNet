[submodule "3rdparty/llama.cpp"]
	path = 3rdparty/llama.cpp
	# Fork propio: el pin (a5c3ec0 + los headers del porter) no existe upstream.
	# HTTPS y repo público para que `git submodule update --init --recursive`
	# funcione en cualquier máquina sin llaves SSH.
	url = https://github.com/joanfgarcia/llama.cpp.git
	branch = sovereign-i2s
